name: Mettre à jour la liste des cours

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: write

jobs:
  generer:
    runs-on: ubuntu-latest

    steps:
      - name: Récupérer les fichiers
        uses: actions/checkout@v4

      - name: Générer cours.json
        shell: bash
        run: |
          python3 - <<'PY'
          import json
          from pathlib import Path
          from urllib.parse import quote

          cours = []
          for p in Path(".").rglob("*"):
              if not p.is_file():
                  continue
              if p.suffix.lower() not in (".html", ".htm"):
                  continue
              if any(x.startswith(".") for x in p.parts):
                  continue
              if p.name.lower() in ("index.html", "index.htm"):
                  continue
              cours.append(quote(p.as_posix(), safe="/"))

          cours.sort(key=str.casefold)
          Path("cours.json").write_text(
              json.dumps(cours, ensure_ascii=False, indent=2) + "\n",
              encoding="utf-8"
          )
          PY

      - name: Enregistrer la liste
        shell: bash
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add cours.json
          if ! git diff --cached --quiet; then
            git commit -m "Mise à jour automatique des cours"
            git push
          fi

